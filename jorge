import { useState, useEffect } from "react";

export default function NaydeliCard() {
  const [isNaydeli, setIsNaydeli] = useState(false);
  const [accepted, setAccepted] = useState(false);
  const [opened, setOpened] = useState(false);
  const [noPosition, setNoPosition] = useState({ top: "0", left: "0" });
  const heartTypes = ["❤️", "💖", "💕", "💞", "💓", "💗", "💘"];
  const [angle, setAngle] = useState(0);
  const [floatingHearts, setFloatingHearts] = useState([]);

  useEffect(() => {
    const interval = setInterval(() => {
      setAngle((prev) => prev + 5);
    }, 100);
    return () => clearInterval(interval);
  }, []);

  useEffect(() => {
    if (isNaydeli) {
      const heartInterval = setInterval(() => {
        setFloatingHearts((prev) => [
          ...prev,
          {
            id: Math.random(),
            left: Math.random() * 100 + "%",
            top: Math.random() * 100 + "%",
            emoji: heartTypes[Math.floor(Math.random() * heartTypes.length)],
          },
        ]);
      }, 300);
      return () => clearInterval(heartInterval);
    }
  }, [isNaydeli]);

  const handleNoHover = () => {
    setNoPosition({
      top: `${Math.random() * 100}%`,
      left: `${Math.random() * 100}%`,
    });
  };

  return (
    <div className="flex flex-col items-center justify-center h-screen bg-pink-200 relative overflow-hidden">
      {[...Array(7)].map((_, index) => {
        const radians = (angle + index * 51.4) * (Math.PI / 180);
        const x = 50 + 20 * Math.cos(radians) + "%";
        const y = 50 + 20 * Math.sin(radians) + "%";
        return (
          <div
            key={index}
            className="absolute text-3xl"
            style={{ left: x, top: y }}
          >
            {heartTypes[index]}
          </div>
        );
      })}
      {!isNaydeli ? (
        <div className="text-center">
          <h1 className="text-3xl font-bold text-red-600">Para Naydeli 💖</h1>
          <button
            onClick={() => setIsNaydeli(true)}
            className="mt-4 px-4 py-2 bg-red-500 text-white rounded-xl hover:bg-red-700"
          >
            Soy Naydeli
          </button>
        </div>
      ) : accepted ? (
        <div className="bg-white p-6 rounded-2xl shadow-xl text-center relative">
          {!opened ? (
            <button
              className="px-6 py-3 bg-red-500 text-white rounded-xl text-xl hover:bg-red-700"
              onClick={() => setOpened(true)}
            >
              📩 Abrir la carta
            </button>
          ) : (
            <>
              <h2 className="text-3xl font-semibold text-red-500">Perfecto, elegiste la mejor opción Naydeli! 💖</h2>
              <p className="text-xl text-gray-600 mt-2">No olvides la fecha: 14 de Febrero a las 6pm</p>
            </>
          )}
        </div>
      ) : (
        <>
          {floatingHearts.map((heart) => (
            <div
              key={heart.id}
              className="absolute text-3xl animate-float"
              style={{ left: heart.left, top: heart.top }}
            >
              {heart.emoji}
            </div>
          ))}
          <div className="bg-white p-6 rounded-2xl shadow-xl text-center relative">
            <h2 className="text-3xl font-semibold text-red-500">¿Quieres ser mi San Valentín? 💕</h2>
            <div className="mt-6 flex justify-center space-x-10">
              <button
                className="px-8 py-3 bg-green-500 text-white rounded-xl text-xl hover:bg-green-700"
                onClick={() => setAccepted(true)}
              >
                Sí 💖
              </button>
              <button
                className="px-8 py-3 bg-gray-400 text-white rounded-xl text-xl absolute"
                style={{ top: noPosition.top, left: noPosition.left }}
                onMouseEnter={handleNoHover}
              >
                No 💔
              </button>
            </div>
          </div>
        </>
      )}
    </div>
  );
}
